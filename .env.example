# Template — copy to .env and fill in your real values.  Copy-Item .env.example .env
# Option A: Windows Authentication (recommended for local SQL Server)
MSSQL_SERVER=localhost
MSSQL_DATABASE=bank
MSSQL_SCHEMA=bank_core
MSSQL_TRUSTED_CONNECTION=yes

# Option B: SQL Server Authentication (uncomment and set MSSQL_TRUSTED_CONNECTION=no)
# MSSQL_USERNAME=sa
# MSSQL_PASSWORD=your_password_here
# MSSQL_TRUSTED_CONNECTION=no
